{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "hakpekerja-api": {
      "root": "apps/api",
      "framework": "express",
      "buildCommand": "npm install && npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "rag",
          "format": "url",
          "env": "RAG_SERVICE_URL"
        }
      ]
    },
    "hakpekerja-web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    },
    "rag": {
      "root": "services/rag",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "hakpekerja-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "hakpekerja-web"
      }
    }
  ]
}
