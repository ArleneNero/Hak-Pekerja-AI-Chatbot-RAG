rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pengguna hanya memiliki akses baca/tulis ke data obrolan miliknya sendiri berdasarkan UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Tolak semua akses ke koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

