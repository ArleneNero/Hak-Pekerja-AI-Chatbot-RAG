# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Allowlist (Client origin)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Private Internal RAG Service (FastAPI)
RAG_SERVICE_URL=http://127.0.0.1:8001

# Firebase Project ID (for token verification and Firestore)
FIREBASE_PROJECT_ID=

