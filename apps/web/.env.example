# Firebase Client Web SDK (Kredensial publik untuk Autentikasi Pengguna)
# Dapatkan nilai ini dari Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL API (Opsional: Kosongkan untuk menggunakan reverse proxy Vite / internal)
VITE_API_BASE_URL=

