# ==============================================================================
# HAKPEKERJA.AI - SERVICES/RAG ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Qdrant Cloud Configuration
QDRANT_URL=https://your-qdrant-cluster-url:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=hakpekerja_legal_4b4babc70203

# 2. Chat LLM Configuration (Custom Provider / Bariska Cloud / OpenRouter)
CHAT_BASE_URL=https://api.bariska.cloud/v1
CHAT_API_KEY=your_bariska_api_key_here
CHAT_MODEL=deepseek-v4.1-flash

# 3. Embedding Configuration (Pencarian Vektor)
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=your_openrouter_api_key_here
EMBEDDING_MODEL=baai/bge-m3
VECTOR_DIM=1024
TOP_K=7

# 4. Service Runtime
HOST=127.0.0.1
PORT=8001
ENVIRONMENT=development
